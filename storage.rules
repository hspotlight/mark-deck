rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Images: readable by anyone, writable by owner only
    match /images/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Exported decks: readable by anyone, writable by owner only
    match /exports/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
